{
  "name": "todo-rocket",
  "version": "1.0.0",
  "description": "CLI/TUI tool for managing TODO.md files",
  "type": "module",
  "bin": {
    "mdd": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome check src/ && markdownlint '**/*.md' --ignore node_modules",
    "lint:fix": "biome check --write src/ && markdownlint '**/*.md' --ignore node_modules --fix",
    "start": "node dist/index.js"
  },
  "keywords": [
    "todo",
    "markdown",
    "cli",
    "tui",
    "task",
    "productivity",
    "terminal"
  ],
  "author": "i-am-fran",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i-am-fran/markdown-do.git"
  },
  "homepage": "https://github.com/i-am-fran/markdown-do#readme",
  "bugs": {
    "url": "https://github.com/i-am-fran/markdown-do/issues"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/core": "^1.0.0-alpha.7",
    "@clack/prompts": "^1.0.0-alpha.9",
    "fast-glob": "^3.3.0",
    "picocolors": "^1.0.0"
  },
  "knip": {
    "ignore": [
      "dist/**"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^1.5.0",
    "@types/node": "^20.0.0",
    "markdownlint-cli": "^0.47.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
